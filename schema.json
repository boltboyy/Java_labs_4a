{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "number": {
        "type": "string",
        "minLength": 1
      },
      "surname": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "patronymic": {
        "type": "string",
        "minLength": 1
      },
      "group": {
        "type": "string",
        "minLength": 1
      },
      "faculty": {
        "type": "string",
        "minLength": 1
      },
      "sessions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "course": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "averageMark": {
              "type": "number"
            },
            "exams": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mark": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                },
                "required": [
                  "subject",
                  "mark"
                ],
                "additionalProperties": false
              }
            },
            "credits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  },
                  "passed": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "subject",
                  "passed"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "number",
            "course",
            "exams",
            "credits"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "number",
      "name",
      "surname",
      "patronymic",
      "group",
      "faculty",
      "sessions"
    ],
    "additionalProperties": false
  }
}